{
  "name": "hanzistep-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run data:validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "pwa-assets-generator",
    "size": "tsx scripts/check-bundle.ts",
    "data:fetch": "tsx scripts/fetch-datasets.ts",
    "data:build": "tsx scripts/build-data-safe.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:hanzi": "tsx scripts/build-hanzi-data.ts",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run size && npm run test:e2e"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "sonner": "2.0.8",
    "ts-fsrs": "5.4.2",
    "workbox-window": "7.4.1",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "happy-dom": "20.14.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-build": "7.4.1"
  }
}
